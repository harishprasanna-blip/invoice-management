# Invoice Management System - Environment Variables
# Copy this file to .env and fill in the actual values
# NEVER commit .env file to version control

# Database
DB_PASSWORD=invoice_secure_password_123
VECTOR_DB_PASSWORD=vector_secure_password_123

# Azure OpenAI (required for AI features)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# SAP Integration (production only)
SAP_API_URL=https://your-sap-instance.com/api
SAP_API_KEY=your_sap_api_key_here
SAP_CLIENT_ID=your_sap_client_id
SAP_CLIENT_SECRET=your_sap_client_secret

# AWS (production only - LocalStack used for development)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=invoice-documents-prod

# Multi-tenancy
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Security
JWT_SECRET_KEY=your_jwt_secret_key_min_256_bits
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data

# Observability
LOG_LEVEL=INFO
ENABLE_DEBUG_LOGGING=false

# Feature Flags
ENABLE_AUTO_RESOLUTION=true
AUTO_RESOLUTION_CONFIDENCE_THRESHOLD=0.90
ENABLE_EARLY_PAYMENT_DISCOUNTS=true
